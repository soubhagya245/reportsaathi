# Environment Configuration
APP_ENV=staging
PORT=8000

# Storage & Database Paths
DB_PATH=data/reportsaathi.db
SCRATCH_DIR=/tmp/scratch

# Security & Data Localization
# Cryptographic salt for irreversible SHA-256 hashing of phone numbers (Never commit production salt)
DATA_SALT=replace_with_a_secure_random_64_char_salt_string

# Meta WhatsApp Cloud API Credentials
# Obtained from Meta Developer Portal (https://developers.facebook.com)
WHATSAPP_TOKEN=replace_with_meta_cloud_api_system_user_token
WHATSAPP_PHONE_ID=replace_with_meta_registered_phone_number_id
WHATSAPP_VERIFY_TOKEN=replace_with_custom_webhook_challenge_verify_token

# Audio & Pipeline Flags
LOCAL_TTS_ENGINE=gtts
ENABLE_AI_SMOOTHING=false
